<?xml version="1.0" encoding="utf-8"?>
<!--
    The Board build's fixed launcher shortcuts: main's copy, with this build's application id
    (dev.herald.android.board) as the targetPackage. Any dynamic shortcuts share the launcher's slots
    with these, so they must leave room for them.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_new_chat"
        android:shortcutId="new_chat"
        android:shortcutLongLabel="@string/shortcut_new_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="hermes://new-chat"
            android:targetClass="dev.hermeskotlin.android.HeraldActivity"
            android:targetPackage="dev.herald.android.board" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_voice"
        android:shortcutId="new_chat_voice"
        android:shortcutLongLabel="@string/shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="hermes://new-chat-voice"
            android:targetClass="dev.hermeskotlin.android.HeraldActivity"
            android:targetPackage="dev.herald.android.board" />
    </shortcut>
    <shortcut
        android:enabled="false"
        android:icon="@mipmap/ic_shortcut_call"
        android:shortcutDisabledMessage="@string/shortcut_voice_chat_moved"
        android:shortcutId="voice_chat"
        android:shortcutLongLabel="@string/shortcut_voice_chat"
        android:shortcutShortLabel="@string/shortcut_voice_chat" />
    <share-target android:targetClass="dev.hermeskotlin.android.HeraldActivity">
        <data android:mimeType="*/*" />
        <category android:name="dev.hermeskotlin.category.BOT_SHARE" />
    </share-target>
</shortcuts>
